{
  "admin": { "disabled": true },
  "logging": { "logs": { "default": { "level": "ERROR" } } },
  "apps": {
    "http": {
      "servers": {
        "bench": {
          "listen": ["127.0.0.1:18081"],
          "automatic_https": { "disable": true },
          "routes": [
            {
              "handle": [
                {
                  "handler": "reverse_proxy",
                  "flush_interval": -1,
                  "transport": {
                    "protocol": "http",
                    "keep_alive": {
                      "enabled": true,
                      "max_idle_conns": 2048,
                      "max_idle_conns_per_host": 2048
                    }
                  },
                  "upstreams": [{ "dial": "127.0.0.1:18080" }]
                }
              ]
            }
          ]
        }
      }
    }
  }
}
